Wine ARM64: load the syscall dispatcher through the TEB in generated syscall stubs

Applies to ValveSoftware/wine commit e60892cc2398b0a83c332a2078c7b85e47bdb42b.
The stub's dispatcher pointer moves from a PC-relative literal next to the
stub to a reserved slot in the thread's TEB, so that a copy of the stub made
elsewhere in memory still reaches the dispatcher.

License: LGPL-2.1-or-later, the license of the two files modified.

--- a/include/wine/asm.h
+++ b/include/wine/asm.h
@@ -244,16 +244,20 @@
     __ASM_GLOBAL_FUNC( __wine_syscall, "jmp *(" __ASM_NAME("__wine_syscall_dispatcher") ")" )
 # endif
 #elif defined __aarch64__
+/* Slot 15 in the ARM64 TEB's reserved CPU-specific data. */
+# define __WINE_ARM64_SYSCALL_DISPATCHER_TEB_OFFSET 0x368
+# define __WINE_ARM64_SYSCALL_DISPATCHER_SLOT 15
+# define __WINE_ARM64_STRINGIFY_(x) #x
+# define __WINE_ARM64_STRINGIFY(x) __WINE_ARM64_STRINGIFY_(x)
 # define __ASM_SYSCALL_FUNC(id,name) \
     __ASM_GLOBAL_FUNC( name, \
                        ".seh_endprologue\n\t" \
                        "mov x8, #(" #id ")\n\t" \
                        "mov x9, x30\n\t" \
-                       "ldr x16, 1f\n\t" \
-                       "ldr x16, [x16]\n\t" \
+                       "ldr x16, [x18, #" \
+                       __WINE_ARM64_STRINGIFY(__WINE_ARM64_SYSCALL_DISPATCHER_TEB_OFFSET) "]\n\t" \
                        "blr x16\n\t" \
-                       "ret\n" \
-                       "1:\t.quad " __ASM_NAME("__wine_syscall_dispatcher") )
+                       "ret" )
 #elif defined __arm64ec__
 # define __ASM_SYSCALL_FUNC(id,name) \
     asm( ".seh_proc \"#" #name "$hp_target\"\n\t" \
--- a/dlls/ntdll/unix/signal_arm64.c
+++ b/dlls/ntdll/unix/signal_arm64.c
@@ -71,6 +71,11 @@
 };
 
 C_ASSERT( sizeof(struct arm64_thread_data) <= sizeof(((struct ntdll_thread_data *)0)->cpu_data) );
+C_ASSERT( __WINE_ARM64_SYSCALL_DISPATCHER_SLOT <
+          sizeof(((struct ntdll_thread_data *)0)->cpu_data) / sizeof(void *) );
+C_ASSERT( offsetof( TEB, GdiTebBatch ) + offsetof( struct ntdll_thread_data, cpu_data ) +
+          __WINE_ARM64_SYSCALL_DISPATCHER_SLOT * sizeof(void *) ==
+          __WINE_ARM64_SYSCALL_DISPATCHER_TEB_OFFSET );
 
 static inline struct arm64_thread_data *arm64_thread_data(void)
 {
@@ -1437,6 +1442,9 @@
  */
 NTSTATUS signal_alloc_thread( TEB *teb )
 {
+    struct ntdll_thread_data *thread_data = (struct ntdll_thread_data *)&teb->GdiTebBatch;
+
+    thread_data->cpu_data[__WINE_ARM64_SYSCALL_DISPATCHER_SLOT] = __wine_syscall_dispatcher;
     return STATUS_SUCCESS;
 }
 
